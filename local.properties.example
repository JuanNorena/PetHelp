# local.properties — ESTE ARCHIVO NO SE SUBE AL REPOSITORIO
# Está ignorado por .gitignore. Cada desarrollador debe crearlo localmente.
#
# ── SDK de Android ───────────────────────────────────────────────────────────
# sdk.dir=C\:\\Users\\TU_USUARIO\\AppData\\Local\\Android\\Sdk
#
# ── Google Maps API Key ───────────────────────────────────────────────────────
# Obtener en: https://console.cloud.google.com → APIs y servicios → Credenciales
# MAPS_API_KEY=AIzaSy...
#
# ── Cloudinary ────────────────────────────────────────────────────────────────
# Obtener en: https://cloudinary.com → Dashboard
# CLOUDINARY_CLOUD_NAME=tu_cloud_name
# CLOUDINARY_UPLOAD_PRESET=tu_unsigned_upload_preset
# CLOUDINARY_API_KEY=tu_api_key
# CLOUDINARY_API_SECRET=tu_api_secret
# CLOUDINARY_URL=cloudinary://<your_api_key>:<your_api_secret>@<your_cloud_name>
#
# ── Firebase AI Logic (Gemini) ───────────────────────────────────────────────
# Se configura en Firebase Console > AI Logic.
# No requiere API keys en local.properties.
