    <string name="privacy_usage_title">3. Use of information</string>
    <string name="privacy_usage_body">We use your data to connect you with shelters and users, personalize pet recommendations, and keep the community safe.</string>
    <string name="privacy_share_title">4. Information sharing</string>
    <string name="privacy_share_body">We do not sell your personal data. We only share required information with verified shelters when you start an adoption process.</string>
    <string name="privacy_rights_title">5. Your rights</string>
    <string name="privacy_rights_body">You can access, correct, or delete your personal data at any time from your account settings.</string>
