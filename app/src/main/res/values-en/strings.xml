    <string name="privacy_title">Privacy</string>
    <string name="privacy_intro_title">1. Introduction</string>
    <string name="privacy_intro_body">At PetHelp, we take your privacy seriously. This policy describes how we collect, use, and protect your personal information when you use our adoption platform.</string>
